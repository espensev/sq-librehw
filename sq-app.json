{
  "schema": "sq.app.v1",
  "machineId": "snd-desk",
  "verifiedOn": "2026-10-27",
  "id": "sq-librehw",
  "kind": "git-source",
  "root": "%MACHINE_TOOLS_ROOT%Monitoring\\sq-librehw",
  "mutableState": [
    {
      "location": "filesystem",
      "path": "%SEV_LOCAL_DATA%\\LibreHardwareMonitor",
      "role": "managed-data-root"
    }
  ],
  "deployments": [
    {
      "kind": "managed-runtime",
      "root": "%MACHINE_TOOLS_ROOT%Monitoring\\LibreHW\\Runtime",
      "executable": "%MACHINE_TOOLS_ROOT%Monitoring\\LibreHW\\Runtime\\LibreHardwareMonitor.Windows.Forms.exe",
      "releaseManifest": "%MACHINE_TOOLS_ROOT%Monitoring\\LibreHW\\Runtime\\release.json",
      "runtimeConfig": "%MACHINE_TOOLS_ROOT%Monitoring\\LibreHW\\Runtime\\librehw.runtime.json",
      "versionAuthority": "releaseManifest; the installed releaseId and commit are read from release.json, never copied here"
    }
  ],
  "consumers": [
    {
      "kind": "scheduledTask",
      "name": "\\SevGrp\\AdminTask\\LibreHW-No-UAC",
      "execute": "%MACHINE_TOOLS_ROOT%Monitoring\\LibreHW\\Runtime\\LibreHardwareMonitor.Windows.Forms.exe",
      "arguments": "",
      "workingDirectory": "%MACHINE_TOOLS_ROOT%Monitoring\\LibreHW\\Runtime"
    },
    {
      "kind": "scriptLauncher",
      "path": "%MACHINE_TOOLS_ROOT%Monitoring\\LibreHW\\Scripts\\Start-LibreHardwareMonitor.ps1"
    },
    {
      "kind": "pathShim",
      "path": "%SEV_LOCAL_BIN%\\librehw.cmd"
    }
  ],
  "source": {
    "kind": "git",
    "remote": "origin",
    "uri": "https://github.com/espensev/sq-librehw.git",
    "branch": "master",
    "versionAuthority": "git; the checked-out commit is read from the repository, never copied here"
  },
  "compatibility": {
    "phase": 2,
    "surfaces": [
      "%MACHINE_TOOLS_ROOT%Monitoring\\LibreHW\\Runtime",
      "%MACHINE_TOOLS_ROOT%Monitoring\\LibreHW\\Scripts\\Start-LibreHardwareMonitor.ps1",
      "%SEV_LOCAL_BIN%\\librehw.cmd"
    ],
    "retiredRoots": [
      "E:\\SQ_HQ",
      "E:\\UserProfile"
    ],
    "recoveryRoot": "%SEV_LOCAL_DATA%\\LibreHardwareMonitor\\release-recovery\\runtime-root-relocation",
    "runtimeInventory": "closed-release-owned; do not add sq-app.json to the managed runtime root"
  }
}
